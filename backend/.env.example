ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://nexora_app:REPLACE_APP_PASSWORD@localhost:5432/nexora
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-development-only-change-before-deploying
# Optional: Google OAuth Web Client ID; register the frontend's origin in Google Console.
GOOGLE_CLIENT_ID=
# Password recovery email (Resend); frontend origin, never the API origin.
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
MAIL_FROM=
# Production: Redis is mandatory; use rediss:// for a managed TLS endpoint.
REDIS_URL=
# Separate owner credential for Alembic; runtime DATABASE_URL uses nexora_app.
MIGRATION_DATABASE_URL=postgresql+psycopg://nexora_migrator:REPLACE_MIGRATION_PASSWORD@localhost:5432/nexora
MIGRATE_ON_START=true
# start.py supervises a separate durable email/reservation worker process.
RUN_WORKER=true
SESSION_IDLE_SECONDS=1800
SESSION_DAYS=14
RESERVATION_MINUTES=20
REQUIRE_VERIFIED_EMAIL=true
NOTIFY_PASSWORD_CHANGE=true
# Same-origin Vite/Vercel proxies need no CORS entries.
ALLOWED_ORIGINS=[]
# Configure only after verifying the ingress strips/spoof-proofs this header.
TRUSTED_PROXY_PEERS=[]
