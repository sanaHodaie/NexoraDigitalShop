ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-development-only-change-before-deploying
# Optional: Google OAuth Web Client ID; register the frontend's origin in Google Console.
GOOGLE_CLIENT_ID=
# Password recovery email (Resend); frontend origin, never the API origin.
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
MAIL_FROM=
