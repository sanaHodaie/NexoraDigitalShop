# ===== نمونه تنظیمات — این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید =====

# توکن ربات از @BotFather — این مقدار فقط نمونه است، توکن واقعی را جایگزین کنید.
# هرگز فایل .env واقعی را در Git یا ZIP قرار ندهید.
BOT_TOKEN=

# آدرس پایه‌ی بک‌اند فروشگاه NexoraDigitalShop
NEXORA_API_URL=http://localhost:8000

# مسیر فهرست محصولات (طبق چیزی که خودتان تأیید کردید)
PRODUCTS_PATH=/api/products

# مسیر جزئیات یک محصول؛ اگر بک‌اند چنین مسیری ندارد، این خط را خالی بگذارید.
# ربات در آن صورت جزئیات را از همان فهرست محصولات برمی‌دارد.
PRODUCT_DETAIL_PATH=/api/products/{id}

# پراکسی اختیاری برای اتصال به api.telegram.org — خالی یعنی اتصال مستقیم.
# نمونه‌ی قالب (آدرس واقعی را خودتان از سرویس معتبر بگیرید):
#   http://127.0.0.1:8080
#   socks5://127.0.0.1:1080
PROXY_URL=

# پسوند قیمت در نمایش؛ خالی بگذارید تا فقط عدد نمایش داده شود (واحد را حدس نمی‌زنیم)
PRICE_SUFFIX=" ریال"

# محل ذخیره‌ی تنظیمات کاربران (زبان و ...)
DATA_DIR=./data

# تعداد محصول در هر صفحه (۱ تا ۱۰)
PAGE_SIZE=5
# Same service credential as backend (not the BotFather token).
TELEGRAM_BOT_API_KEY=
FRONTEND_URL=http://localhost:3000
