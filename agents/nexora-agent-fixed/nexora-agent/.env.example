# --- LLM ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# --- Catalogue source ---
# "file": reads data/catalog-products.json (works with no backend running)
# "api": reads products from the configured Nexora backend.
CATALOG_SOURCE=file
CATALOG_FILE=data/catalog-products.json
NEXORA_API_BASE=http://127.0.0.1:8000

# --- Limits ---
RATE_LIMIT_PER_MINUTE=15
DAILY_REQUEST_CAP=1000   # 0 = unlimited; hard stop for API cost
MAX_TOOL_ROUNDS=6
# Exact origins only, JSON list. Not needed when the site proxies /api (same-origin).
ALLOWED_ORIGINS=[]

# ======================= Free / alternative providers =======================
# Use LLM_PROVIDER=openai with ANY OpenAI-compatible endpoint. Pick ONE block.
#
# (a) Ollama, runs on your own PC, free, no internet or account needed:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
#   LLM_API_KEY=
# (b) Google Gemini free tier (key from aistudio.google.com):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash
#   LLM_API_KEY=your-key
# (c) Groq free tier (key from console.groq.com):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=your-key
